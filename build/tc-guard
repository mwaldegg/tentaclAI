#!/usr/bin/env python3
"""tc-guard – Claude Code's PostToolUse hook in tentaclAI (managed settings, root-owned; runs as claude).

Every tool call lands in the audit log through `svc tool-report` (tool and target – the file, URL, query or command;
svc commands log themselves). Unless started with --no-scan (INJECTION_GUARD off), it also scans the results that
don't come through svc – WebFetch, WebSearch, MCP tools, files Claude reads, other commands – with the same heuristic as
svc (tclib.injection_signals): on a finding Claude gets a warning next to the result, and the audit entry becomes
"flagged" (each finding with an excerpt) with a notification. Never blocks or fails a tool call: any error → silent exit 0.
Files in a result (an image or PDF Claude reads, MCP image/resource blocks) are not scanned as base64 – that is the file,
not a hidden message; a PDF's text is taken out with pdftotext and scanned page by page.
The same findings in the same result again (a job reading tentaclAI's own scanner tests over and over) get a short
reminder instead of the full warning – once per session; changed content warns in full again.
"""
import base64
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, "/usr/local/lib/tentaclai")

SCAN = re.compile(r"WebFetch|WebSearch|Read|Bash|mcp__.*")  # tools whose results can carry someone else's text
SKIP_READ = ("/etc/tentaclai/", "/home/claude/.claude/", "/workspace/CLAUDE.md", "/workspace/SERVICES.md")
PDFTOTEXT = "/usr/bin/pdftotext"  # poppler-utils
PDF_PAGES, PDF_SECONDS, PDF_TEXT = 50, 6, 200_000  # PDF_SECONDS for all PDFs of a result together – the hook has 10 s
PDF_NOTES = ("PDF text not checked", "PDF text partly checked")  # the worse one first
FILE_KEYS = ("base64", "data", "blob")  # where a result carries a file: Read {"file": {"base64", "type"}}, MCP {"data"|"blob", "mimeType"}
B64 = re.compile(r"[A-Za-z0-9+/=\r\n]*")  # a file's base64 – no spaces, so a sentence never passes as one
SEEN_DIR = os.path.join(tempfile.gettempdir(), f"tc-guard-{os.getuid()}")  # per session: the findings Claude was warned about
SVC_ONLY = re.compile(r"\s*(?:sudo\s+(?:-n\s+)?)?svc\s[^;&|`$<>()\n]*")  # one svc call, nothing chained or substituted
# svc calls whose output svc doesn't scan itself (command output, logs, rows, diffs) – scanned here, logged by svc
SVC_UNSCANNED = re.compile(r"\s*(?:sudo\s+(?:-n\s+)?)?svc\s+(ssh|docker|compose|db|git|jobs)\b")


def _media(d):
    return str(d.get("mimeType") or d.get("media_type") or d.get("type") or "").lower()


def is_file(d, key, read=False):
    """a file in a result: "base64" in Read's file result, or "base64"/"data"/"blob" next to a media type of an image,
    audio, video or a PDF – and only when the value looks like base64 (a claimed media type is text from the result)"""
    m = _media(d)
    typed = m.startswith(("image/", "audio/", "video/")) or m == "application/pdf"
    return (typed or read and key == "base64") and B64.fullmatch(d[key]) is not None


def text_of(value, limit=400_000, read=False):
    """(all strings of a tool result up to limit characters, the files in it as [(media type, base64)]) – read: the
    result of Read, whose "base64" is the file Claude reads"""
    out, files, size = [], [], 0
    stack = [value]
    while stack and size < limit:
        v = stack.pop()
        if isinstance(v, str):
            out.append(v)
            size += len(v)
        elif isinstance(v, dict):
            keys = [k for k, x in v.items() if isinstance(x, str) and k in FILE_KEYS and is_file(v, k, read)]
            files.extend((_media(v), v[k]) for k in keys)
            stack.extend(reversed([x for k, x in v.items() if k not in keys]))
        elif isinstance(v, list):
            stack.extend(reversed(v))
    return "\n".join(out)[:limit], files


def pdf_pages(b64, seconds=PDF_SECONDS):
    """(the text of a PDF's pages – pdftotext, first PDF_PAGES pages –, whether there was more) – None when it can't be
    read (no tool, encrypted, broken, too slow, no time left); a scanned PDF gives empty pages"""
    if seconds <= 0:
        return None
    try:
        data = base64.b64decode(b64, validate=False)
    except ValueError:
        return None
    fd, path = tempfile.mkstemp(suffix=".pdf")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        r = subprocess.run([PDFTOTEXT, "-q", "-l", str(PDF_PAGES + 1), "-enc", "UTF-8", path, "-"], capture_output=True,
                           timeout=seconds)
        if r.returncode != 0:
            return None
        pages = r.stdout[:PDF_TEXT].decode("utf-8", "replace").split("\f")  # every page ends with \f
        return pages[:PDF_PAGES], len(r.stdout) > PDF_TEXT or len(pages) > PDF_PAGES + 1
    except (OSError, subprocess.SubprocessError):
        return None
    finally:
        os.unlink(path)


def pdf_findings(tclib, b64, seconds=PDF_SECONDS):
    """(findings with the page in the excerpt, note) – note says when the text could not be checked, or only in part"""
    got = pdf_pages(b64, seconds)
    if got is None:
        return [], PDF_NOTES[0]
    pages, cut = got
    found = []
    for n, page in enumerate(pages, 1):
        for reason, excerpt in tclib.injection_findings(page):
            if reason not in (r for r, _ in found):
                found.append((reason, f"PDF page {n}, {excerpt}"))
    return found[:5], PDF_NOTES[1] if cut else ""


def _seen_file(event):
    """the session's file in SEEN_DIR – '' without a session id, or when the dir in the shared /tmp isn't Claude's own
    (another user could fill it with keys and turn warnings into short repeats)"""
    session = re.sub(r"[^A-Za-z0-9-]", "", str(event.get("session_id") or ""))[:64]
    if not session:
        return ""
    try:
        os.makedirs(SEEN_DIR, mode=0o700, exist_ok=True)
        st = os.lstat(SEEN_DIR)
    except OSError:
        return ""
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        return ""
    return os.path.join(SEEN_DIR, session)


def repeated(event, tool, target, text, findings, files=()):
    """True when this session got the same findings for the same result before (and remember them otherwise) – keyed by
    a hash of the content, the files of the result (a PDF) included, so a file that changed is a new warning; no
    session id: never a repeat"""
    path = _seen_file(event)
    if not path:
        return False
    def digest(s):
        return hashlib.sha256(s.encode("utf-8", "replace")).hexdigest()
    key = hashlib.sha256(json.dumps([tool, target, findings, digest(text), [digest(f"{m}:{b}") for m, b in files]])
                         .encode()).hexdigest()[:32]
    try:
        with open(path) as f:
            if key in f.read().split():
                return True
    except OSError:
        pass
    try:
        with open(path, "a") as f:
            f.write(key + "\n")
    except OSError:
        pass
    return False


def forget():
    """PreCompact: the earlier warnings may be gone from the summary – the next finding warns in full again"""
    try:
        path = _seen_file(json.load(sys.stdin))
        if path:
            os.unlink(path)
    except Exception:  # noqa: BLE001 – no file, no session: nothing to forget
        pass
    return 0


def main():
    if "--forget" in sys.argv[1:]:
        return forget()
    try:
        import tclib
        event = json.load(sys.stdin)
    except Exception:  # noqa: BLE001
        return 0
    tool = str(event.get("tool_name") or "")
    tin = event.get("tool_input") or {}
    if not isinstance(tin, dict):
        tin = {}
    svc_call = tool == "Bash" and SVC_ONLY.fullmatch(str(tin.get("command", "")))
    if svc_call and not SVC_UNSCANNED.match(str(tin.get("command", ""))):
        return 0  # svc logs and scans what it does itself – "svc x; curl …" is logged and scanned as a whole
    findings, note, text, files = [], "", "", []
    if "--no-scan" not in sys.argv[1:] and SCAN.fullmatch(tool) and not (
            tool == "Read" and str(tin.get("file_path", "")).startswith(SKIP_READ)):  # tentaclAI's own instructions name svc commands on purpose
        text, files = text_of(event.get("tool_response"), read=tool == "Read")
        if text:  # also when svc already warned in it – its warning sentences are left out, the rest is scanned
            findings = tclib.injection_findings(text)
        pdf_path = tool == "Read" and str(tin.get("file_path", "")).lower().endswith(".pdf")
        deadline, notes = time.monotonic() + PDF_SECONDS, set()
        for media, b64 in files:
            if media == "application/pdf" or media == "pdf" or pdf_path and not media.startswith("image/"):
                more, n = pdf_findings(tclib, b64, deadline - time.monotonic())
                notes.add(n)
                findings = (findings + [f for f in more if f[0] not in (r for r, _ in findings)])[:tclib.MAX_FINDINGS]
        note = next((n for n in PDF_NOTES if n in notes), "")
    if findings:
        reasons = "; ".join(dict.fromkeys(r for r, _ in findings))
        again = repeated(event, tool, tclib.tool_target(tool, tin), text, findings, files)
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": (
            tclib.HOOK_REPEAT.format(reasons=reasons) if again else tclib.HOOK_WARNING.format(tool=tool, reasons=reasons))}}))
    if svc_call and not findings:
        return 0  # svc logged the call itself
    try:  # audit (+ notification) through svc (root) – in the background, the hook returns right away; the details go
        # through stdin (excerpts can be long and may hold what Claude read – not for argv, which every process sees)
        p = subprocess.Popen(["sudo", "-n", "/usr/local/bin/svc", "tool-report"], stdin=subprocess.PIPE,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        p.stdin.write(json.dumps({"tool": tool[:60], "target": tclib.tool_target(tool, tin), "findings": findings,
                                  "note": note}).encode())
        p.stdin.close()
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:  # noqa: BLE001 – a hook must never break a tool call
        sys.exit(0)
