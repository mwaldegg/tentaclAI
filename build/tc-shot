#!/usr/bin/env node
// tc-shot – screenshot of a web page or HTML file with the image's headless Chromium (Playwright, /opt/pw-browsers).
//   tc-shot <url|file.html> <out.png> [--width 1280] [--height 800] [--full] [--wait ms] [--selector css] [--insecure]
//   tc-shot --selftest     renders a local page with umlauts and emoji (no network) – run in the image build
// Pages go through the egress gateway (HTTPS_PROXY, NO_PROXY), like curl; --insecure accepts self-signed certificates.
'use strict';
const fs = require('fs');
const os = require('os');
const path = require('path');
const { chromium } = require('playwright');

const USAGE = 'usage: tc-shot <url|file.html> <out.png> [--width 1280] [--height 800] [--full] [--wait ms] [--selector css] [--insecure]\n'
    + '       tc-shot --selftest';

function parse(argv) {
    const o = { width: 1280, height: 800, full: false, wait: 0, selector: '', insecure: false, pos: [] };
    for (let i = 0; i < argv.length; i++) {
        const a = argv[i];
        const val = () => { if (i + 1 >= argv.length) throw new Error(`${a} needs a value`); return argv[++i]; };
        if (a === '--width') o.width = parseInt(val(), 10);
        else if (a === '--height') o.height = parseInt(val(), 10);
        else if (a === '--wait') o.wait = parseInt(val(), 10);
        else if (a === '--selector') o.selector = val();
        else if (a === '--full') o.full = true;
        else if (a === '--insecure') o.insecure = true;
        else if (a === '--selftest') o.selftest = true;
        else if (a === '-h' || a === '--help') o.help = true;
        else if (a.startsWith('--')) throw new Error(`unknown option ${a}`);
        else o.pos.push(a);
    }
    if (!(o.width > 0 && o.height > 0) || o.wait < 0) throw new Error('width, height and wait must be numbers');
    return o;
}

// the gateway from the environment – Chromium itself does not read HTTPS_PROXY
function proxy() {
    const server = process.env.HTTPS_PROXY || process.env.https_proxy || process.env.HTTP_PROXY || process.env.http_proxy;
    if (!server) return undefined;
    return { server, bypass: process.env.NO_PROXY || process.env.no_proxy || '' };
}

function target(t) {
    if (/^[a-z][a-z0-9+.-]*:/i.test(t)) return t;
    const p = path.resolve(t);
    if (!fs.existsSync(p)) throw new Error(`no such file: ${t} (a URL needs its scheme, e.g. https://)`);
    return 'file://' + p;
}

function isPng(file) {
    const b = fs.readFileSync(file);
    return b.length > 1000 && b.subarray(0, 8).equals(Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]));
}

async function selftest() {
    const html = '<!doctype html><meta charset="utf-8"><body style="font:32px sans-serif;padding:24px">'
        + '<h1>Grüße aus der Sandbox – äöüß ÄÖÜ €</h1><p>Emoji: 🐙 ✅ 📸</p></body>';
    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tc-shot-'));
    try {
        for (const [name, opts] of [['bundled', {}], ['/opt/pw-browsers/chromium', { executablePath: '/opt/pw-browsers/chromium' }]]) {
            const out = path.join(dir, 'selftest.png');
            const browser = await chromium.launch(opts);
            try {
                const page = await browser.newPage({ viewport: { width: 800, height: 300 } });
                await page.setContent(html);
                const fonts = await page.evaluate(() => document.fonts.check('32px "Noto Color Emoji"'));
                await page.screenshot({ path: out });
                if (!isPng(out)) throw new Error(`${name}: no PNG written`);
                console.log(`✓ ${name}: ${browser.version()}, PNG ${fs.statSync(out).size} bytes, emoji font ${fonts ? 'found' : 'MISSING'}`);
                if (!fonts) throw new Error('font "Noto Color Emoji" missing');
            } finally {
                await browser.close();
            }
        }
    } finally {
        fs.rmSync(dir, { recursive: true, force: true });
    }
}

async function shot(o) {
    const [t, out] = o.pos;
    const url = target(t);
    const browser = await chromium.launch({ proxy: url.startsWith('file:') ? undefined : proxy() });
    try {
        const ctx = await browser.newContext({ viewport: { width: o.width, height: o.height }, ignoreHTTPSErrors: o.insecure });
        const page = await ctx.newPage();
        const res = await page.goto(url, { waitUntil: 'networkidle', timeout: 30000 });
        if (o.wait) await page.waitForTimeout(o.wait);
        const opts = { path: out, fullPage: o.full };
        if (o.selector) await page.locator(o.selector).first().screenshot({ path: out });
        else await page.screenshot(opts);
        const status = res ? res.status() : 0;
        console.log(`✓ ${out} (${o.width}×${o.height}${o.full ? ', full page' : ''}${o.selector ? ', ' + o.selector : ''}) – ${status ? 'HTTP ' + status : 'no response'}: ${page.url()}`);
        if (status >= 400) process.exitCode = 1;
    } finally {
        await browser.close();
    }
}

(async () => {
    let o;
    try {
        o = parse(process.argv.slice(2));
    } catch (e) {
        console.error(`tc-shot: ${e.message}\n${USAGE}`);
        process.exit(2);
    }
    if (o.help) { console.log(USAGE); return; }
    try {
        if (o.selftest) await selftest();
        else if (o.pos.length === 2) await shot(o);
        else { console.error(USAGE); process.exit(2); }
    } catch (e) {
        console.error(`tc-shot: ${e.message.split('\n')[0]}`);
        if (/ERR_TUNNEL_CONNECTION_FAILED|ERR_PROXY/.test(e.message)) console.error('tc-shot: the egress gateway refused the destination – allow it in tentacontrol → Network or Approvals');
        if (/Timeout .* exceeded/.test(e.message) && !/^file:/.test(String(o.pos[0]))) console.error('tc-shot: no answer – an unknown destination waits for a network approval (svc pending; tentacontrol → Approvals), or the page never settles (try --wait instead)');
        if (/ERR_CERT/.test(e.message)) console.error('tc-shot: certificate not trusted – --insecure accepts a self-signed one (homelab only)');
        process.exit(1);
    }
})();
