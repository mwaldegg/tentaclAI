#!/usr/bin/env python3
"""ssh helper for hosts with login "cert" (Match … exec in ssh/config.d/_certs.conf, generated by tentacontrol):
make sure ~/.ssh/certs/<alias>-cert.pub is a certificate from tentacontrol's SSH CA that stays valid for a while –
keep the current one, or sign a fresh key pair. Exit 0: ssh uses it; 1: the Match block doesn't apply and ssh falls
back to the key. Runs for root only (svc, tentacontrol's checks) – the svc token is root's."""
import fcntl
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request

MIN_LEFT = 30  # seconds a reused certificate must still be valid – enough to log in
CONTROL = os.environ.get("TC_CONTROL_INTERNAL", "http://tentacontrol:8080")


def _read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def fail(msg):
    print(f"tc-cert: {msg} – trying the key", file=sys.stderr)
    sys.exit(1)


alias = sys.argv[1] if len(sys.argv) == 2 else ""
if not re.fullmatch(r"[A-Za-z0-9._-]{1,40}", alias) or os.geteuid() != 0:
    sys.exit(1)
tc_dir = os.environ.get("TC_DIR") or _read("/etc/tentaclai/tc-dir") or "/opt/tentaclai"
base = os.path.join(os.path.expanduser("~/.ssh/certs"), alias)
key, cert, meta = base, base + "-cert.pub", base + ".json"
os.makedirs(os.path.dirname(base), mode=0o700, exist_ok=True)

with open(base + ".lock", "w") as lock:  # parallel ssh calls: one signs, the others take its certificate
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        with open(meta) as f:
            left = float(json.load(f).get("valid_before", 0)) - time.time()
    except (OSError, ValueError, AttributeError):
        left = 0
    if left > MIN_LEFT and os.path.exists(key) and os.path.exists(cert):
        sys.exit(0)
    for f in (key + ".new", key + ".new.pub"):
        if os.path.exists(f):
            os.remove(f)
    if subprocess.call(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", f"tentaclai {alias}", "-f", key + ".new"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL):
        fail("ssh-keygen failed")
    token = _read(os.path.join(tc_dir, "data", "control", "svc-token"))
    if not token:
        fail("no svc token (data/control/svc-token) – is tentacontrol running?")
    req = urllib.request.Request(CONTROL + "/internal/ssh-cert", method="POST",
                                 data=json.dumps({"alias": alias, "public_key": _read(key + ".new.pub")}).encode(),
                                 headers={"X-TC-Token": token, "Content-Type": "application/json"})
    try:
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(req, timeout=15) as r:
            res = json.load(r)
    except urllib.error.HTTPError as e:
        try:
            msg = json.load(e).get("error", "")
        except ValueError:
            msg = ""
        fail(f"{alias}: tentacontrol refused the certificate ({msg or e.code})")
    except (OSError, ValueError) as e:
        fail(f"{alias}: no certificate from tentacontrol ({e})")
    if not str(res.get("certificate", "")).startswith("ssh-ed25519-cert-v01@openssh.com "):
        fail(f"{alias}: unexpected answer from tentacontrol")
    with open(cert + ".new", "w") as f:
        f.write(res["certificate"].strip() + "\n")
    os.chmod(cert + ".new", 0o600)
    os.replace(key + ".new", key)
    os.replace(key + ".new.pub", key + ".pub")
    os.replace(cert + ".new", cert)
    with open(meta, "w") as f:
        json.dump({"valid_before": res.get("valid_before", 0)}, f)
sys.exit(0)
