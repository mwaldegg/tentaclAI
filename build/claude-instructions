#!/usr/bin/env python3
"""Print Claude's user-level CLAUDE.md: image template + site values + optional host docs + local rules."""
import glob
import json
import os
import re
import sys

sys.path.insert(0, "/usr/local/lib/tentaclai")
import tclib  # noqa: E402  shared with svc and tentacontrol

TEMPLATE = "/etc/tentaclai/CLAUDE.base.md"
HOST_DOCS = "/etc/tentaclai/host-docs.md"

tc_dir = os.environ.get("TC_DIR") or (open("/etc/tentaclai/tc-dir").read().strip() if os.path.exists("/etc/tentaclai/tc-dir") else "/opt/tentaclai")
site = tclib.read_env(os.path.join(tc_dir, ".env"))  # runs as root (entrypoint, svc sync) – only non-secret values are used


def docker_hosts():
    rows = []
    for name, svc in tclib.load_services(os.path.join(tc_dir, "services"), tclib.load_systems(tc_dir)).items():
        d = svc.get("docker")
        if not d or not tclib.enabled(svc):
            continue
        rows.append(f"| `{svc.get('name') or name}` | `{d.get('ssh_host')}` | **{tclib.access(d.get('access'))}** | `{tclib.render(str(d.get('stacks_dir', '–')), site)}` | {svc.get('description', '')} |")
    if not rows:
        return "### Docker hosts\n\nNone configured – this sandbox has no Docker access."
    return "### Docker hosts\n\n| Host | SSH host | Access | Stacks dir | Description |\n|---|---|---|---|---|\n" + "\n".join(rows)


def ssh_hosts():
    hosts = tclib.ssh_hosts("/root/.ssh/config.d")
    if not hosts:
        return "### SSH hosts\n\nNone configured."
    rows = [f"| `{h['alias']}` | **{tclib.ssh_access('/root/.ssh/config.d', h['alias'])}** | {h['user'] or '–'} | {h['hostname'] or '–'} | "
            f"{('`' + h['sudo'] + ' <cmd>`') if h['sudo'] else '–'} |" for h in hosts]
    return ("### SSH hosts\n\n`svc ssh <host> <command>`. Access: `confirm` = every command waits for approval, `write` = allowed "
            "(still ask before changes), `read` = only the status commands below. Plain status commands (`uptime`, `df -h`, `free`, `ps`, `ls`, "
            "`docker ps|logs|inspect`, `systemctl status`, `journalctl -u …`, `ip a`, `ss -tlnp` – one command, no `;`/`|`/`$`/redirects) "
            "run without approval everywhere – prefer them. File contents: `svc files <name> cat <path>` – only for a service with a "
            "files part (`svc list`), not a plain SSH or Docker host; there use `svc ssh <host> cat <path>` (not a status "
            "command, so it may need approval). The command runs in the remote "
            "shell: pass it as one quoted string and put patterns with `|`, spaces or `{{…}}` in single quotes inside it "
            "(`svc ssh gate \"grep -E 'a|b' /etc/x\"`); for containers `svc docker <host> ps` needs no quoting. With a sudo prefix: "
            "`svc ssh <host> <prefix> <cmd>` (never type a password); `svc docker`/`svc compose` add it themselves.\n\n"
            "| Host | Access | User | Hostname | sudo |\n|---|---|---|---|---|\n" + "\n".join(rows))


values = {
    "TC_DIR": tc_dir,
    "DOCKER_HOSTS": docker_hosts(),
    "SSH_HOSTS": ssh_hosts(),
    "TC_HOSTNAME": site.get("TC_HOSTNAME") or os.environ.get("TC_HOSTNAME") or os.uname().nodename,
    "CONTROL_URL": site.get("CONTROL_URL") or os.environ.get("CONTROL_URL") or "tentacontrol",
}
text = open(TEMPLATE).read()
for k, v in values.items():
    text = text.replace("{{" + k + "}}", v)

local = os.path.join(tc_dir, "local", "CLAUDE.md")
extra = []
if os.path.isfile(HOST_DOCS) and os.path.getsize(HOST_DOCS) > 0:
    # referenced, not imported: it is long and only needed for work on the host – saves context in every request
    extra += ["## Host documentation", "",
              f"The host's own documentation (stacks, storage, backups, reverse proxy, conventions) is in `{HOST_DOCS}` "
              "(read-only). **Read it before you work on the host's stacks, backups, proxy or system settings**; "
              "for everything else it is not needed.", ""]
if os.path.isfile(local) and os.path.getsize(local) > 0:
    extra += ["## Site-specific rules", "", f"@{local}", ""]
print(text.rstrip() + ("\n\n" + "\n".join(extra) if extra else "") + "\n")
