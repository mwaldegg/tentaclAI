# tentaclai – settings & secrets. Copy to .env (mode 600) or run ./tentaclai.sh init.
# Most values can later be edited in tentacontrol → Settings / Services.

# ── Site ──────────────────────────────────────────────────────────────────────────
# absolute host path of this stack (set by init)
TC_DIR=
# compose files: generic + your site override
COMPOSE_FILE=compose.yaml:compose.override.yaml
# Docker socket of THIS host – used by tentacontrol only, to run tentaclai. Claude reaches docker hosts – this one
# too – only over SSH (services/_templates/docker-ssh.json)
DOCKER_SOCKET=/var/run/docker.sock
# optional: a Markdown file describing the host (Claude's instructions point to it; read before work on the host)
HOST_DOCS=
# optional: own root CA (PEM) for internal https services
CA_CERT=
# name of the Docker host (set by init) – how Claude refers to it
TC_HOSTNAME=
# your internal domain – used to prefill service templates (e.g. n8n.<domain>)
TC_DOMAIN=example.lan
TZ=UTC
# where tentacontrol is reachable (shown in setup link and help)
CONTROL_URL=
# tentacontrol port binding when no reverse proxy is used
CONTROL_BIND=127.0.0.1
CONTROL_PORT=8484
# reverse proxies whose X-Forwarded-For counts (addresses/CIDRs, comma-separated) – * = any sender except the sandbox
# and the gateway; with a chain of proxies (e.g. CDN → nginx) list them, otherwise the last hop counts as the client
FORWARDED_ALLOW_IPS=*
CLAUDE_CPUS=4
CLAUDE_MEMORY=8g

# ── Jobs ──────────────────────────────────────────────────────────────────────────
# text tools a read-only job may chain with svc (empty = echo, head, tail, grep, jq, wc, cut, tr, date, sleep)
JOB_READONLY_HELPERS=

# ── Claude Code ───────────────────────────────────────────────────────────────────
CLAUDE_CODE_VERSION=latest
GIT_USER_NAME=
GIT_USER_EMAIL=

# ── Remote control (claude.ai/code + app) ─────────────────────────────────────────
# read on every (re)start of the session – "RC neu starten" in tentacontrol applies changes
RC_ENABLED=true
RC_NAME=
RC_WORKDIR=/workspace
RC_EXTRA_ARGS=
RC_RESTART_DELAY=30
# Claude Code telemetry, error reports and /bug: false = off (default)
CLAUDE_TELEMETRY=false

# ── Service tokens (referenced as ${VAR} in services/*.json) ──────────────────────
# Only svc (root) reads this file – none of these values reach Claude or its environment.
GH_TOKEN=

# ── network ──
# egress gateway: permissive = allow and record every destination, enforce = unknown destinations wait for your
# approval, learn = permissive for EGRESS_LEARN_MINUTES from the first connection, then enforce (you review what was seen)
EGRESS_MODE=learn
EGRESS_LEARN_MINUTES=60
# enforce mode: bare IP addresses without a rule – block (default) or ask
EGRESS_DIRECT_IP=block

# ── logs ──
# tentacontrol's container log: text (for people) or json (one object per line, for a log shipper); level info/debug/warning/error
LOG_FORMAT=text
LOG_LEVEL=info

# ── updates ──
# check GitHub for new tentaclAI releases every 6 h (shown in the sidebar); false = no requests
UPDATE_CHECK=true
# owner/repo whose releases are checked (change for a fork)
UPDATE_REPO=mwaldegg/tentaclai
